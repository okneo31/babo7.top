{
  "name": "babotalk",
  "version": "2.0.0",
  "private": true,
  "description": "BaboTalk — 보안 메신저 (NestJS + React 모노레포)",
  "workspaces": [
    "shared",
    "backend",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run start:dev --workspace=backend",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build -w @babotalk/shared && npm run build -w @babotalk/backend && npm run build -w @babotalk/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/okneo31/babo7.top.git"
  },
  "license": "MIT"
}
