# ===== BaboTalk v2 backend 환경변수 =====
# 값이 없으면 코드의 (legacy 호환) 기본값이 쓰인다. 운영에선 반드시 채울 것.

PORT=80

# Mongo / Redis (Docker compose 네트워크 기준)
MONGO_URI=mongodb://mongo:27017/babotalk
REDIS_URL=redis://redis:6379

# 인증 (#10 하드닝) — 기본값은 legacy와 동일하나 운영에선 교체 필수
JWT_SECRET=babo_secret_key_v1_final
JWT_EXPIRES=7d
ADMIN_ID=admin
ADMIN_PW=babo1234
MASTER_INVITE=MASTER_KEY

# 파일 업로드 (#8)
UPLOAD_DIR=./uploads
FILE_TOKEN_SECRET=change_me_file_secret
MAX_UPLOAD_MB=200

# 웹푸시 (#1) — `npx web-push generate-vapid-keys` 로 생성
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@babo7.top

# CORS 화이트리스트 (콤마 구분)
CORS_ORIGINS=https://babo7.top,http://localhost:5173
