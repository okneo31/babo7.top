# ===== BaboTalk v2 backend 환경변수 =====
# 시크릿은 소스에 하드코딩하지 않는다. 아래 [필수] 항목이 비면 서버가 부팅을 거부한다.
# 이 파일은 템플릿이며 실제 .env 는 git에 올리지 않는다(.gitignore).

PORT=80

# 운영 파라미터(비밀 아님)
MONGO_URI=mongodb://mongo:27017/babotalk
REDIS_URL=redis://redis:6379
ADMIN_ID=admin
JWT_EXPIRES=7d
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=200
CORS_ORIGINS=https://babo7.top,http://localhost:5173
VAPID_SUBJECT=mailto:admin@babo7.top

# [필수] 시크릿 — 강한 랜덤값으로 채울 것 (예: openssl rand -base64 48)
JWT_SECRET=
ADMIN_PW=
FILE_TOKEN_SECRET=

# [필수 아님] 마스터 초대코드 — 설정 시에만 무초대 가입 허용(백도어). 비우면 비활성.
MASTER_INVITE=

# 웹푸시(#1) — `npx web-push generate-vapid-keys` 로 생성
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# WebRTC ICE — 자격은 코드에 하드코딩하지 않고 여기서만 주입.
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=
# 권장: use-auth-secret 모드(시간제한 자격). coturn의 static-auth-secret과 동일값.
TURN_SECRET=
TURN_TTL=86400
# 또는 정적 자격(레거시 coturn lt-cred-mech). TURN_SECRET 비울 때만 사용.
TURN_USERNAME=
TURN_PASSWORD=
